,{"k":"tree","s":[5,5],"sc":1.2,"sway":2,"x":250,"y":175},{"k":"tree","s":[5,5],"sc":1.2,"sway":2,"x":300,"y":175},{"a":{"fill":"#f0b429","height":20,"width":24,"x":188,"y":80},"k":"sh","s":[5,5],"t":"rect"},{"a":{"d":"M193 80v-8a7 7 0 0114 0v8","fill":"none","stroke":"#8a6500","stroke-width":3},"k":"sh","s":[5,5],"t":"path"},{"k":"tx","s":[5,5],"sz":12,"tx":{"en":"Carbon locked up","ta":"கார்பன் பூட்டப்பட்டுள்ளது"},"x":200,"y":50}],"look":{"en":"Where the carbon dioxide arrows enter, and where they leave.","ta":"கார்பன் டை ஆக்சைடு அம்புகள் எங்கே நுழைகின்றன, எங்கே வெளியேறுகின்றன என்று பாருங்கள்."},"steps":[{"c":{"en":"Carbon is always moving between the air, plants, soil and oceans. This is the carbon cycle.","ta":"கார்பன் எப்போதும் காற்று, தாவரங்கள், மண், கடல்களுக்கு இடையே நகர்கிறது. இதுவே கார்பன் சுழற்சி."}},{"c":{"en":"Plants take in carbon dioxide from the air to grow (photosynthesis) and give out oxygen.","ta":"தாவரங்கள் வளர காற்றிலிருந்து கார்பன் டை ஆக்சைடை எடுத்து (ஒளிச்சேர்க்கை) ஆக்சிஜனை வெளியிடுகின்றன."}},{"c":{"en":"The oceans also dissolve carbon dioxide from the air.","ta":"கடல்களும் காற்றிலிருந்து கார்பன் டை ஆக்சைடைக் கரைத்துக்கொள்கின்றன."}},{"c":{"en":"Burning coal, oil and gas releases carbon that was stored underground for millions of years, much faster than nature can absorb it.","ta":"நிலக்கரி, எண்ணெய், வாயுவை எரிப்பது இலட்சக்கணக்கான ஆண்டுகளாக நிலத்தடியில் சேமிக்கப்பட்ட கார்பனை, இயற்கை உறிஞ்சுவதைவிட மிக வேகமாக வெளியிடுகிறது."}},{"c":{"en":"Land and oceans absorb about half of our emissions. The rest stays in the air. The CO₂ in the sea also makes it more acidic.","ta":"நிலமும் கடலும் நம் உமிழ்வில் ஏறக்குறைய பாதியை உறிஞ்சுகின்றன. மீதி காற்றிலேயே தங்குகிறது. கடலிலுள்ள CO₂ அதை அதிக அமிலமாகவும் ஆக்குகிறது."}},{"c":{"en":"Protecting forests, mangroves and wetlands keeps carbon locked up, and protects people from floods and heat too.","ta":"காடுகள், அலையாத்திக் காடுகள், ஈரநிலங்களைப் பாதுகாப்பது கார்பனைப் பூட்டி வைப்பதுடன் வெள்ளம், வெப்பத்திலிருந்தும் மக்களைக் காக்கிறது."}}]},"city":{"bg":"day","e":[{"heat":1,"k":"sun","r":20,"s":[0,5],"x":350,"y":40},{"a":{"fill":"#7aa35a","height":55,"width":400,"x":0,"y":185},"k":"sh","s":[0,0],"t":"rect"},{"k":"tree","s":[0,0],"sc":1.7,"sway":2,"x":60,"y":185},{"k":"tree","s":[0,0],"sc":1.4,"sway":2,"x":130,"y":185},{"k":"tree","s":[0,0],"sc":1.7,"sway":2,"x":300,"y":185},{"a":{"cx":210,"cy":200,"fill":"#4aa3df","rx":45,"ry":8},"k":"sh","s":[0,0],"t":"ellipse"},{"col":"#ffffff","head":false,"k":"flow","n":5,"s":[0,0],"wob":5,"x1":210,"x2":210,"y1":196,"y2":120},{"h":80,"k":"therm","s":[0,0],"tx":{"en":"Cooler","ta":"குளிர்ச்சி"},"v0":0.4,"v1":0.4,"x":360,"y":205},{"a":{"fill":"#555c66","height":55,"width":400,"x":0,"y":185},"k":"sh","s":[1,5],"t":"rect"},{"a":{"fill":"#7b8794","height":75,"width":50,"x":40,"y":110},"dur":4,"k":"sh","s":[1,5],"t":"rect","tw":{"fill":["#7b8794","#b4624a"]}},{"a":{"fill":"#7b8794","height":105,"width":50,"x":100,"y":80},"dur":4,"k":"sh","s":[1,5],"t":"rect","tw":{"fill":["#7b8794","#b4624a"]}},{"a":{"fill":"#7b8794","height":65,"width":45,"x":170,"y":120},"dur":4,"k":"sh","s":[1,5],"t":"rect","tw":{"fill":["#7b8794","#b4624a"]}},{"a":{"fill":"#7b8794","height":90,"width":55,"x":230,"y":95},"dur":4,"k":"sh","s":[1,5],"t":"rect","tw":{"fill":["#7b8794","#b4624a"]}},{"a":{"fill":"#7b8794","height":60,"width":50,"x":300,"y":125},"dur":4,"k":"sh","s":[1,5],"t":"rect","tw":{"fill":["#7b8794","#b4624a"]}},{"col":"#ffd66b","k":"flow","n":5,"s":[1,1],"x1":330,"x2":255,"y1":56,"y2":100},{"k":"tx","s":[1,1],"sz":12,"tx":{"en":"Heat soaks in","ta":"வெப்பம் உறிஞ்சப்படுகிறது"},"x":200,"y":30},{"a":{"cx":340,"cy":40,"fill":"#f4efe6","r":16},"k":"sh","s":[2,2],"t":"circle"},{"col":"#ff6a4a","head":false,"k":"flow","n":4,"s":[2,2],"wob":5,"x1":65,"x2":65,"y1":106,"y2":40},{"col":"#ff6a4a","head":false,"k":"flow","n":4,"s":[2,2],"wob":5,"x1":125,"x2":125,"y1":76,"y2":20},{"col":"#ff6a4a","head":false,"k":"flow","n":4,"s":[2,2],"wob":5,"x1":257,"x2":257,"y1":90,"y2":30},{"col":"#ffffff","halo":"#000","k":"tx","s":[2,2],"sz":11,"tx":{"en":"Stored heat is released at night","ta":"சேமித்த வெப்பம் இரவில் வெளியேறுகிறது"},"x":200,"y":226},{"a":{"fill":"#cfd8dc","height":10,"width":16,"x":46,"y":150},"k":"sh","s":[3,3],"t":"rect"},{"a":{"fill":"#cfd8dc","height":10,"width":16,"x":106,"y":140},"k":"sh","s":[3,3],"t":"rect"},{"a":{"fill":"#cfd8dc","height":10,"width":16,"x":236,"y":150},"k":"sh","s":[3,3],"t":"rect"},{"col":"#ff9a3c","k":"flow","n":3,"s":[3,3],"x1":62,"x2":92,"y1":155,"y2":155},{"col":"#ff9a3c","k":"flow","n":3,"s":[3,3],"x1":122,"x2":160,"y1":145,"y2":145},{"col":"#ff9a3c","k":"flow","n":3,"s":[3,3],"x1":252,"x2":290,"y1":155,"y2":155},{"col":"#ffffff","k":"flow","n":3,"s":[3,3],"x1":5,"x2":30,"y1":176,"y2":176},{"col":"#c0392b","k":"tx","s":[3,3],"sz":14,"tx":{"en":"✗","ta":"✗"},"x":18,"y":166},{"col":"#ffffff","halo":"#000","k":"tx","s":[3,3],"sz":10.5,"tx":{"en":"Air conditioners push heat outside","ta":"குளிரூட்டிகள் வெப்பத்தை வெளியே தள்ளுகின்றன"},"x":200,"y":226},{"h":110,"k":"therm","s":[4,4],"tx":{"en":"Countryside","ta":"கிராமப்புறம்"},"v0":0.45,"v1":0.45,"x":120,"y":208},{"h":110,"k":"therm","s":[4,4],"tx":{"en":"City","ta":"நகரம்"},"v0":0.8,"v1":0.8,"x":280,"y":208},{"k":"tree","s":[5,5],"sc":1.5,"sway":2,"x":25,"y":185},{"k":"tree","s":[5,5],"sc":1.4,"sway":2,"x":98,"y":185},{"k":"tree","s":[5,5],"sc":1.6,"sway":2,"x":215,"y":185},{"k":"tree","s":[5,5],"sc":1.4,"sway":2,"x":290,"y":185},{"k":"tree","s":[5,5],"sc":1.6,"sway":2,"x":365,"y":185},{"dur":4,"h":90,"k":"therm","s":[5,5],"tx":{"en":"Cooler","ta":"குளிர்ச்சி"},"v0":0.8,"v1":0.5,"x":160,"y":208}],"look":{"en":"How the buildings change colour, and the two thermometers.","ta":"கட்டடங்கள் எப்படி நிறம் மாறுகின்றன, இரண்டு வெப்பமானிகள் என்ன காட்டுகின்றன என்று பாருங்கள்."},"steps":[{"c":{"en":"A leafy village: trees give shade, and water evaporating from leaves and ponds cools the air.","ta":"மரங்கள் நிறைந்த கிராமம்: மரங்கள் நிழல் தருகின்றன; இலைகளிலும் குளங்களிலும் ஆவியாகும் நீர் காற்றைக் குளிர்விக்கிறது."}},{"c":{"en":"A city: dark roads, roofs and concrete soak up sunshine like a hot pan.","ta":"நகரம்: கருமையான சாலைகள், கூரைகள், காங்கிரீட் சூடான வாணலி போல வெயிலை உறிஞ்சுகின்றன."}},{"bg":"night","c":{"en":"At night they slowly give that stored heat back to the air.","ta":"இரவில் அவை சேமித்த வெப்பத்தை மெதுவாகக் காற்றுக்குத் திருப்பித் தருகின்றன."}},{"c":{"en":"Buildings block the wind, and air conditioners push even more hot air outside.","ta":"கட்டடங்கள் காற்றைத் தடுக்கின்றன; குளிரூட்டிகள் இன்னும் அதிகச் சூடான காற்றை வெளியே தள்ளுகின்றன."}},{"c":{"en":"So a city can be several degrees hotter than the countryside, especially at night.","ta":"எனவே நகரம் கிராமப்புறத்தைவிட, குறிப்பாக இரவில், பல டிகிரி அதிக வெப்பமாக இருக்கலாம்."}},{"c":{"en":"Trees, ponds, white roofs and open spaces help cool the city, and they protect elders the most.","ta":"மரங்கள், குளங்கள், வெள்ளைக் கூரைகள், திறந்தவெளிகள் நகரத்தைக் குளிர்விக்க உதவுகின்றன; அவை முதியோரை அதிகம் காக்கின்றன."}}]},"ice":{"bg":"day","e":[{"a":{"d":"M20 200L150 70L280 200Z","fill":"#8c9a7a","stroke":"none"},"k":"sh","s":[0,2],"t":"path"},{"a":{"fill":"#6f9a52","height":40,"width":400,"x":0,"y":200},"k":"sh","s":[0,2],"t":"rect"},{"col":"#ffffff","h":150,"k":"rain","n":18,"s":[0,0],"spd":0.4,"sw":3.4,"w":140,"x":80,"y":15},{"a":{"d":"M105 125L150 70L195 125L170 145L130 140Z","fill":"#ffffff","stroke":"none"},"dur":4,"k":"sh","s":[0,0],"t":"path","tw":{"opacity":[0,1]}},{"k":"tx","s":[0,0],"sz":12,"tx":{"en":"Snow piles up and turns to ice","ta":"பனி குவிந்து பனிக்கட்டியாகிறது"},"x":200,"y":34},{"a":{"d":"M105 125L150 70L195 125L222 200L178 200L130 140Z","fill":"#e6f6fd","stroke":"none"},"k":"sh","s":[1,1],"t":"path"},{"col":"#7cc3ee","k":"flow","n":3,"s":[1,1],"spd":0.12,"x1":160,"x2":200,"y1":112,"y2":186},{"a":{"d":"M222 200L400 214","fill":"none","stroke":"#4aa3df","stroke-linecap":"round","stroke-width":4},"k":"sh","s":[1,1],"t":"path"},{"k":"tx","s":[1,1],"sz":12,"tx":{"en"