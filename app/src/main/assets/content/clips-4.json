rx":66,"ry":8},"k":"sh","opacity":0.55,"pulse":1.2,"s":[4,4],"t":"ellipse"},{"k":"tx","s":[4,4],"sz":11,"tx":{"en":"White ice reflects","ta":"வெண்பனி திருப்புகிறது"},"x":110,"y":208},{"k":"tx","s":[4,4],"sz":11,"tx":{"en":"Dark water absorbs","ta":"கருநீர் உறிஞ்சுகிறது"},"x":290,"y":208}],"look":{"en":"How big the glacier is in each scene, and the shape of the river line.","ta":"ஒவ்வொரு காட்சியிலும் பனியாறு எவ்வளவு பெரியது, ஆற்றுக் கோட்டின் வடிவம் என்ன என்று பாருங்கள்."},"steps":[{"c":{"en":"Glaciers form where more snow falls than melts. Over many years, the snow piles up and turns to ice.","ta":"உருகுவதைவிட அதிகப் பனி விழும் இடங்களில் பனியாறுகள் உருவாகின்றன. பல ஆண்டுகளில் பனி குவிந்து பனிக்கட்டியாகிறது."}},{"c":{"en":"The ice slowly flows downhill. In balance, new snow replaces the ice that melts at the bottom.","ta":"பனிக்கட்டி மெதுவாகச் சரிவில் கீழே பாய்கிறது. சமநிலையில், அடியில் உருகும் பனியை புதிய பனி ஈடு செய்கிறது."}},{"c":{"en":"In a warmer world, more ice melts than new snow can replace, so the glacier shrinks.","ta":"வெப்பமான உலகில் புதிய பனி ஈடு செய்வதைவிட அதிகப் பனி உருகுகிறது; அதனால் பனியாறு சுருங்குகிறது."}},{"c":{"en":"Meltwater feeds rivers, so rivers swell at first. Later, when the ice is gone, they run low.","ta":"உருகிய நீர் ஆறுகளுக்குப் போகிறது; முதலில் ஆறுகள் பெருகும். பின்னர் பனி தீர்ந்ததும் அவை வற்றும்."}},{"c":{"en":"Melting sea ice exposes dark ocean. White ice reflects sunlight, but dark water absorbs it, so the Arctic warms even faster.","ta":"உருகும் கடல் பனி கருமையான கடலை வெளிப்படுத்துகிறது. வெண்பனி சூரிய ஒளியைத் திருப்பும்; கருநீர் அதை உறிஞ்சும்; அதனால் ஆர்க்டிக் இன்னும் வேகமாக வெப்பமாகிறது."}}]},"ozone":{"bg":"night","e":[{"a":{"fill":"#6f9a52","height":26,"width":400,"x":0,"y":214},"k":"sh","t":"rect"},{"k":"sun","r":18,"s":[0,3],"x":200,"y":26},{"a":{"fill":"#b07be0","height":26,"width":400,"x":0,"y":96},"k":"sh","opacity":0.55,"s":[0,1],"t":"rect"},{"col":"#e6c8ff","k":"tx","s":[0,4],"sz":11,"tx":{"en":"Ozone layer","ta":"ஓசோன் படலம்"},"x":60,"y":88},{"col":"#d58cff","head":false,"k":"flow","n":4,"s":[0,0],"x1":110,"x2":110,"y1":48,"y2":94},{"col":"#d58cff","head":false,"k":"flow","n":4,"s":[0,0],"x1":200,"x2":200,"y1":48,"y2":94},{"col":"#d58cff","head":false,"k":"flow","n":4,"s":[0,0],"x1":290,"x2":290,"y1":48,"y2":94},{"col":"#d58cff","head":false,"k":"flow","n":2,"op":0.35,"s":[0,0],"x1":340,"x2":340,"y1":48,"y2":208},{"k":"tx","s":[0,0],"sz":11,"tx":{"en":"UV absorbed","ta":"UV உறிஞ்சப்படுகிறது"},"x":200,"y":66},{"a":{"fill":"#ffffff","height":42,"width":24,"x":40,"y":172},"k":"sh","s":[1,1],"t":"rect"},{"col":"#7bd88f","head":false,"k":"flow","n":4,"r":4,"s":[1,1],"wob":5,"x1":52,"x2":80,"y1":170,"y2":102},{"col":"#7bd88f","head":false,"k":"flow","n":4,"r":4,"s":[1,1],"wob":5,"x1":150,"x2":150,"y1":214,"y2":104},{"col":"#7bd88f","k":"tx","s":[1,1],"sz":11,"tx":{"en":"CFCs rise","ta":"CFC மேலே செல்கின்றன"},"x":120,"y":160},{"a":{"fill":"#b07be0","height":26,"width":400,"x":0,"y":96},"dur":4,"k":"sh","s":[1,1],"t":"rect","tw":{"opacity":[0.55,0.3]}},{"a":{"fill":"#b07be0","height":26,"width":150,"x":0,"y":96},"k":"sh","opacity":0.55,"s":[2,2],"t":"rect"},{"a":{"fill":"#b07be0","height":26,"width":150,"x":250,"y":96},"k":"sh","opacity":0.55,"s":[2,2],"t":"rect"},{"col":"#ffffff","k":"tx","s":[2,2],"sz":11,"tx":{"en":"Hole","ta":"துளை"},"x":200,"y":112},{"col":"#d58cff","head":true,"k":"flow","n":6,"s":[2,2],"x1":200,"x2":200,"y1":48,"y2":208},{"col":"#d58cff","head":true,"k":"flow","n":5,"s":[2,2],"x1":170,"x2":170,"y1":48,"y2":208},{"col":"#d58cff","head":true,"k":"flow","n":5,"s":[2,2],"x1":230,"x2":230,"y1":48,"y2":208},{"col":"#d58cff","head":false,"k":"flow","n":3,"s":[2,2],"x1":80,"x2":80,"y1":48,"y2":94},{"k":"tx","s":[2,2],"sz":11,"tx":{"en":"More UV reaches the ground","ta":"அதிக UV தரையை எட்டுகிறது"},"x":200,"y":232},{"a":{"fill":"#b07be0","height":26,"width":150,"x":0,"y":96},"k":"sh","opacity":0.55,"s":[3,3],"t":"rect"},{"a":{"fill":"#b07be0","height":26,"width":150,"x":250,"y":96},"k":"sh","opacity":0.55,"s":[3,3],"t":"rect"},{"a":{"fill":"#b07be0","height":26,"width":100,"x":150,"y":96},"dur":6,"k":"sh","s":[3,3],"t":"rect","tw":{"opacity":[0,0.55]}},{"k":"tx","s":[3,3],"sz":12,"tx":{"en":"Montreal Protocol: healing","ta":"மாண்ட்ரீல் ஒப்பந்தம்: ஆறுகிறது"},"x":200,"y":70},{"a":{"fill":"#ffffff","height":120,"width":160,"x":25,"y":60},"k":"sh","opacity":0.92,"s":[4,4],"t":"rect"},{"a":{"fill":"#ffffff","height":120,"width":160,"x":215,"y":60},"k":"sh","opacity":0.92,"s":[4,4],"t":"rect"},{"col":"#6a2c91","halo":"#fff","k":"tx","s":[4,4],"sz":14,"tx":{"en":"Ozone hole","ta":"ஓசோன் துளை"},"x":105,"y":90},{"col":"#222","halo":"#fff","k":"tx","s":[4,4],"sz":12,"tx":{"en":"= UV rays","ta":"= புற ஊதாக் கதிர்கள்"},"x":105,"y":115},{"col":"#b3361f","halo":"#fff","k":"tx","s":[4,4],"sz":14,"tx":{"en":"Global warming","ta":"புவி வெப்பமாதல்"},"x":295,"y":90},{"col":"#222","halo":"#fff","k":"tx","s":[4,4],"sz":12,"tx":{"en":"= trapped heat","ta":"= சிறைப்பட்ட வெப்பம்"},"x":295,"y":115},{"col":"#ffffff","halo":"#000","k":"tx","s":[4,4],"sz":12,"tx":{"en":"Two different problems","ta":"இரண்டு வேறுபட்ட சிக்கல்கள்"},"x":200,"y":214}],"look":{"en":"Which purple arrows are stopped, and which get through.","ta":"எந்த ஊதா அம்புகள் தடுக்கப்படுகின்றன, எவை கடந்து வருகின்றன என்று பாருங்கள்."},"steps":[{"c":{"en":"High above, the ozone layer works like sunscreen. It absorbs most of the Sun’s harmful ultraviolet (UV) rays.","ta":"உயரத்தில் ஓசோன் படலம் சன்ஸ்கிரீன் போலச் செயல்படுகிறது. சூரியனின் தீங்கான புற ஊதா (UV) கதிர்களில் பெரும்பகுதியை அது உறிஞ்சுகிறது."}},{"c":{"en":"Old chemicals called CFCs, from old fridges and sprays, drifted up and broke ozone apart.","ta":"பழைய குளிர்சாதனப் பெட்டிகள், ஸ்ப்ரேக்களிலிருந்து வந்த CFC எனப்படும் வேதிப்பொருள்கள் மேலே சென்று ஓசோனை உடைத்தன."}},{"c":{"en":"The layer thinned, especially over Antarctica: the ozone hole. More UV reaches the ground.","ta":"படலம் மெலிந்தது, குறிப்பாக அண்டார்டிகாவின் மேல்: ஓசோன் துளை. அதிக UV கதிர்கள் தரையை எட்டுகின்றன."}},{"c":{"en":"The world agreed in the Montreal Protocol to stop using them. The layer is slowly healing.","ta":"அவற்றைப் பயன்படுத்துவதை நிறுத்த உலகம் மாண்ட்ரீல் ஒப்பந்தத்தில் ஒப்புக்கொண்டது. படலம் மெதுவாக ஆறி வருகிறது."}},{"c":{"en":"Do not mix it up with global warming. The ozone hole is about UV rays. Global warming is about trapped heat.","ta":"இதைப் புவி வெப்பமாதலுடன் குழப்பிக்கொள்ளாதீர்கள். ஓசோன் துளை புற ஊதாக் கதிர்கள் பற்றியது. புவி வெப்பமாதல் சிறைப்பட்ட வெப்பம் பற்றியது."}}]},"warn":{"bg":"day","e":[{"a":{"fill":"#7aa35a","height":40,"width":400,"x":0,"y":200},"k":"sh","s":[0,0],"t":"rect"},{"a":{"fill":"#d0d7de","height":10,"stroke":"#34495e","stroke-width":1.5,"transform":"translate(200 40)","width":18,"x":-9,"y":-5},"k":"sh","mv":[110,8,9],"s":[0,0],"t":"rect"},{"k":"tx","s":[0,0],"sz":11,"tx":{"en":"Satellite","ta":"செயற்கைக்கோள்"},"x":200,"y":70},{"a":{"d":"M60 200a30 30 0 0160 0Z","fill":"#e8eef2","stroke":"#34495e","stroke-width":2},"k":"sh","s":[0,0],"t":"path"},{"a":{"stroke":"#2a7da6","stroke-linecap":"round","stroke-width":3,"x1":90,"x2":90,"y1":200,"y2":150},"k":"sh","s":[0,0],"spin":[90,200,60],"t":"line"},{"k":"tx","s":[0,0],"sz":11,"tx":{"en":"Radar","ta":"ரேடார்"},"x":90,"y":222},{"a":{"stroke":"#34495e","stroke-linecap":"round","stroke-width":3,"x1":300,"x2":300,"y1":200,"y2":140},"k":"sh","s":[0,0],"t":"line"},{"a":{"stroke":"#34495e","stroke-linecap":"round","stroke-width":3,"x1":300,"x2":322,"y1":140,"y2":140},"k":"sh","s":[0,0],"spin":[300,140,220],"t":"line"},{"a":{"stroke":"#34495e","stroke-linecap":"round","stroke-width":3,"x1":300,"x2":278,"y1":140,"y2":140},"k":"sh","s":[0,0],"spin":[300,140,220],"t":"line"},{"k":"tx","s":[0,0],"sz":11,"tx":{"en":"Weather station","ta":"வானிலை நிலையம்"},"x":300,"y":222},{"a":{"fill":"#1f6f8b","height":27,"width":32,"x":60,"y":52},"k":"sh","pulse":2,"s":[1,1],"t":"rect"},{"a":{"fill":"#eba46d","height":27,"width":32,"x":60,"y":82},"k":"sh","pulse":3,"s":[1,1],"t":"rect"},{"a":{"fill