th"},{"col":"#ffffff","k":"flow","n":5,"s":[3,3],"spd":0.25,"x1":20,"x2":360,"y1":100,"y2":100},{"k":"tx","s":[3,3],"sz":11,"tx":{"en":"Low, fast","ta":"தாழ்வு, வேகம்"},"x":80,"y":84},{"k":"tx","s":[3,3],"sz":11,"tx":{"en":"Tall, slow","ta":"உயரம், மெதுவு"},"x":330,"y":84},{"a":{"d":"M230 240L330 140L400 140V240Z","fill":"#c9b27a","stroke":"none"},"k":"sh","s":[4,4],"t":"path"},{"col":"#2a7da6","dur":4,"k":"wave","s":[4,4],"x1":0,"x2":400,"y":172,"yTw":[172,205]},{"a":{"d":"M230 240L330 140L400 140V240Z","fill":"#c9b27a","stroke":"none"},"k":"sh","s":[4,4],"t":"path"},{"dur":5,"go":[80,-45],"k":"person","pose":"run","s":[4,4],"sc":1.4,"x":290,"y":175},{"k":"tx","s":[4,4],"sz":11,"tx":{"en":"Sea pulls back or ground shakes?","ta":"கடல் உள்வாங்குகிறதா, நிலம் அதிர்கிறதா?"},"x":130,"y":60},{"col":"#2e7d32","k":"tx","s":[4,4],"sz":10.5,"tx":{"en":"✓ Go uphill or inland now","ta":"✓ உடனே உயரமான இடம் அல்லது உள்நாட்டுக்குச் செல்லுங்கள்"},"x":130,"y":80}],"look":{"en":"What lifts the water in each case: wind, or an earthquake.","ta":"ஒவ்வொரு நிலையிலும் நீரை எது உயர்த்துகிறது: காற்றா, நிலநடுக்கமா என்று பாருங்கள்."},"steps":[{"c":{"en":"Storm surge: a cyclone’s strong winds and low pressure push the sea up and onto the coast.","ta":"புயல் கடல் எழுச்சி: புயலின் வலுவான காற்றும் குறைந்த காற்றழுத்தமும் கடலை உயர்த்தி கரைமேல் தள்ளுகின்றன."}},{"bg":"day","c":{"en":"Storm surge is weather, so it can be forecast days ahead. There is time to move to safety.","ta":"புயல் கடல் எழுச்சி வானிலை நிகழ்வு; எனவே நாட்களுக்கு முன்பே முன்னறிவிக்கலாம். பாதுகாப்பான இடத்துக்குச் செல்ல நேரம் உண்டு."}},{"bg":"day","c":{"en":"Tsunami: an earthquake under the sea suddenly lifts the sea floor. A huge mass of water starts to move.","ta":"சுனாமி: கடலுக்கடியில் நிலநடுக்கம் திடீரெனக் கடல் தரையை உயர்த்துகிறது. மிகப் பெரிய நீர்த்திரள் நகரத் தொடங்குகிறது."}},{"bg":"day","c":{"en":"In deep water the waves are low but very fast. Near the shore they slow down, bunch up and grow tall.","ta":"ஆழ்கடலில் அலைகள் தாழ்வாகவும் மிக வேகமாகவும் இருக்கும். கரைக்கு அருகில் அவை மெதுவாகி, குவிந்து, உயரமாகின்றன."}},{"bg":"day","c":{"en":"A tsunami is not weather or climate. If the ground shakes strongly near the coast, or the sea suddenly pulls back, go uphill or inland at once.","ta":"சுனாமி வானிலையோ காலநிலையோ அல்ல. கடற்கரைக்கு அருகில் நிலம் வலுவாக அதிர்ந்தாலோ கடல் திடீரென உள்வாங்கினாலோ உடனே உயரமான இடத்துக்கு அல்லது உள்நாட்டுக்குச் செல்லுங்கள்."}}]},"warm":{"bg":"day","e":[{"a":{"fill":"#7aa35a","height":40,"width":400,"x":0,"y":200},"k":"sh","s":[0,1],"t":"rect"},{"a":{"fill":"#6b7280","height":60,"width":80,"x":260,"y":140},"k":"sh","s":[0,0],"t":"rect"},{"a":{"fill":"#4b5563","height":34,"width":12,"x":272,"y":108},"k":"sh","s":[0,0],"t":"rect"},{"a":{"fill":"#4b5563","height":24,"width":12,"x":312,"y":118},"k":"sh","s":[0,0],"t":"rect"},{"col":"#444444","head":false,"k":"flow","n":6,"r":6,"s":[0,0],"wob":7,"x1":278,"x2":278,"y1":106,"y2":50},{"col":"#444444","head":false,"k":"flow","n":5,"r":5,"s":[0,0],"wob":7,"x1":318,"x2":318,"y1":116,"y2":60},{"a":{"fill":"#c0392b","height":16,"width":56,"x":60,"y":182},"k":"sh","s":[0,0],"t":"rect"},{"a":{"cx":75,"cy":200,"fill":"#222","r":6},"k":"sh","s":[0,0],"t":"circle"},{"a":{"cx":103,"cy":200,"fill":"#222","r":6},"k":"sh","s":[0,0],"t":"circle"},{"col":"#666666","head":false,"k":"flow","n":3,"r":4,"s":[0,0],"wob":4,"x1":60,"x2":30,"y1":186,"y2":160},{"k":"tx","s":[0,0],"sz":12,"tx":{"en":"Coal, oil and gas burned","ta":"நிலக்கரி, எண்ணெய், வாயு எரிப்பு"},"x":200,"y":28},{"a":{"fill":"#8fa3b0","height":70,"width":60,"x":80,"y":200},"dur":1.5,"k":"sh","s":[1,1],"t":"rect","tw":{"height":[0,70],"y":[200,130]}},{"a":{"fill":"#e2573a","height":105,"width":60,"x":200,"y":200},"delay":1.5,"dur":2,"k":"sh","s":[1,1],"t":"rect","tw":{"height":[0,105],"y":[200,95]}},{"k":"tx","s":[1,1],"sz":12,"tx":{"en":"≈280 ppm","ta":"≈280 ppm"},"x":110,"y":120},{"k":"tx","s":[1,1],"sz":12,"tx":{"en":">420 ppm","ta":">420 ppm"},"x":230,"y":85},{"k":"tx","s":[1,1],"sz"