    <string name="home_title">காலநிலை நினைவுகள், சான்றுகள், முடிவுகள்</string>
    <string name="home_body">மூத்தோரிடம் கேளுங்கள். சான்றைச் சோதியுங்கள். இணைந்து முடிவெடுங்கள்.</string>
    <string name="about_purpose_title">நோக்கம்</string>
    <string name="about_purpose">காலக்கோலம் முழுமையாக இணையமின்றி இயங்கும் இருமொழிக் காலநிலை கல்விச் செயலி.</string>
    <string name="about_storage_title">இந்தச் சாதனத்தில் சேமிக்கப்படுவது</string>
    <string name="about_storage">செயலி முன்னேற்றமும் பதிவுகளும் இந்தச் சாதனத்தில் மட்டுமே சேமிக்கப்படும். எதுவும் வெளியே அனுப்பப்படாது.</string>
    <string name="about_version">பதிப்பு 2.0.0</string>
    <string name="about_credit">Department of Zoology, GASC, Nagercoil / Created by R. Ramesh</string>
    <string name="about_sources_title">ஆதாரங்கள்</string>
    <string name="about_sources">M1 நிலையில் அறிவியல் படங்கள் காட்டப்படவில்லை. பின்னர் சேர்க்கப்படும் ஒவ்வொரு படத்திற்கும் பெயரிட்ட ஆதாரம் இத்திரையில் வழங்கப்பட வேண்டும்.</string>
    <string name="about_limits_title">வரம்புகள்</string>
    <string name="about_limits">ஊர்சபை ஒரு எளிமைப்படுத்தப்பட்ட மாதிரி. அனுபவச் சாட்சி ஒரு அளவீடு அல்ல. தமிழ் மனித ஆய்வில் உள்ளது.</string>
    <string name="contact_placeholder">CONTACT PLACEHOLDER — வெளியீட்டுக்கு முன் மாற்றவும்</string>
    <string name="reset_data">தரவை மீட்டமை</string>
    <string name="reset_confirm_title">அனைத்து செயலித் தரவையும் மீட்டமைக்கவா?</string>
    <string name="reset_confirm_body">இந்தச் சாதனத்தில் சேமிக்கப்பட்ட காலக்கோலம் நிலை நீக்கப்படும்.</string>
